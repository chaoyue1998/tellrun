{
  "name": "agent-relay",
  "version": "1.0.0",
  "description": "通过 IM 与服务器上的编码 Agent 对话，提交开发任务、查看进度、处理审批并继续会话。",
  "type": "module",
  "bin": {
    "agent-relay": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/cli.ts run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/cli.js run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@grammyjs/auto-retry": "2.0.2",
    "commander": "15.0.0",
    "grammy": "1.46.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "author": "",
  "license": "ISC"
}
