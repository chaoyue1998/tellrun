{
  "name": "tellrun",
  "version": "1.0.1",
  "description": "Self-hosted Telegram bot for remote AI coding with OpenAI Codex CLI, persistent sessions, and streaming replies.",
  "keywords": [
    "codex",
    "codex-cli",
    "openai",
    "openai-codex",
    "telegram",
    "telegram-bot",
    "ai-coding",
    "ai-agent",
    "coding-agent",
    "coding-assistant",
    "remote-coding",
    "self-hosted",
    "chatops",
    "bridge"
  ],
  "homepage": "https://github.com/chaoyue1998/tellrun#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaoyue1998/tellrun.git"
  },
  "bugs": {
    "url": "https://github.com/chaoyue1998/tellrun/issues"
  },
  "type": "module",
  "bin": {
    "tellrun": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/cli.ts run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "start": "node --env-file-if-exists=.env dist/cli.js run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@grammyjs/auto-retry": "2.0.2",
    "commander": "15.0.0",
    "grammy": "1.46.0",
    "json-rpc-2.0": "1.8.1",
    "pino": "10.4.0",
    "which": "7.0.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "@types/which": "3.0.4",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "author": "chaoyue1998",
  "license": "MIT"
}
